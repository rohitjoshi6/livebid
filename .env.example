# Backend
APP_ENV=development
HTTP_ADDR=:8080
JWT_SECRET=replace-with-a-local-dev-secret
CORS_ALLOWED_ORIGINS=http://localhost:5173

# PostgreSQL
POSTGRES_DB=livebid
POSTGRES_USER=livebid
POSTGRES_PASSWORD=livebid
DATABASE_URL=postgres://livebid:livebid@localhost:5432/livebid?sslmode=disable

# Redis
REDIS_ADDR=localhost:6379
REDIS_PASSWORD=

# Auction rules
ANTI_SNIPING_WINDOW_SECONDS=10
ANTI_SNIPING_EXTENSION_SECONDS=10
AUCTION_EXPIRATION_INTERVAL_SECONDS=2
AUCTION_EXPIRATION_BATCH_SIZE=50
